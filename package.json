{
  "name": "nochore",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "test": "npm --workspace @nochore/harness test && npm run test:worker",
    "test:worker": "vitest run services/worker/src/lib/agent-runtime.test.ts services/worker/src/lib/tool-provider.test.ts",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "format": "biome format --fix ."
  },
  "dependencies": {
    "@composio/core": "^0.6.7",
    "@composio/vercel": "^0.6.7",
    "@mariozechner/pi-coding-agent": "^0.62.0",
    "@trigger.dev/sdk": "^4.4.3",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@trigger.dev/build": "^4.4.3"
  }
}
